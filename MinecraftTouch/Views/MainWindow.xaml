<Window x:Class="MinecraftTouch.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="{DynamicResource ToolIcon}" Title="我的世界java版触屏工具 --by xztx127" Width="900" Height="720" MinWidth="650" MinHeight="500"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource SideBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,18">
            <Button x:Name="ThemeButton" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="16,0,0,0" Click="Theme_Click"/>
            <Image Source="{DynamicResource ToolIconLarge}" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <StackPanel>
                <TextBlock Text="我的世界java版触屏工具" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="1.0.0  ·  by xztx127" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </DockPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="先用任意启动器打开 Minecraft Java 版，再选择游戏窗口开启触摸板。" TextWrapping="Wrap"/>
            <DockPanel Margin="0,10,0,0">
                <Button DockPanel.Dock="Right" Content="刷新窗口" Click="Refresh_Click" Padding="10,5"/>
                <CheckBox x:Name="ShowAllCheck" Content="显示所有窗口（手动选择）" VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            </DockPanel>
            <TextBlock x:Name="SummaryText" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
        <Grid Grid.Row="2" MinHeight="100">
            <ListBox x:Name="WindowList" SelectionChanged="Selection_Changed" Background="{DynamicResource PanelBrush}"
                     BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate><DataTemplate>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding Error}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Status}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyHint" Text="尚未发现游戏窗口&#x0a;如果游戏已打开，请勾选“显示所有窗口”手动选择。"
                       TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False" Margin="20"/>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <WrapPanel>
                <Button x:Name="EnableButton" Content="开启触摸板" Style="{StaticResource PrimaryButton}" Click="Enable_Click" Margin="0,0,8,8" IsEnabled="False"/>
                <Button x:Name="DisableButton" Content="关闭触摸板" Click="Disable_Click" Margin="0,0,8,8" IsEnabled="False"/>
                <Button x:Name="FocusButton" Content="切换到游戏" Click="Focus_Click" Margin="0,0,8,8" IsEnabled="False"/>
                <Button Content="按键与布局" Click="Layout_Click" Margin="0,0,8,8"/>
                <Button Content="使用更多功能" ToolTip="作者的启动器有更高级的功能" Click="MoreFeatures_Click" Margin="0,0,8,8"/>
            </WrapPanel>
            <Expander Header="触摸板参数" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,6">
                <Grid Margin="0,12,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0"><TextBlock Text="按钮大小"/><Slider x:Name="ScaleSlider" Minimum="0.5" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,7"/><TextBlock Text="{Binding Value, ElementName=ScaleSlider, StringFormat={}{0:F1} 倍}"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="不透明度"/><Slider x:Name="OpacitySlider" Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,7"/><TextBlock Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:F0}%}"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="视角灵敏度"/><Slider x:Name="SensitivitySlider" Minimum="0.4" Maximum="4" TickFrequency="0.2" IsSnapToTickEnabled="True" Margin="0,7"/><TextBlock Text="{Binding Value, ElementName=SensitivitySlider, StringFormat={}{0:F1}}"/></StackPanel>
                </Grid>
            </Expander>
            <TextBlock x:Name="StatusText" Text="参数自动保存，下次开启触摸板生效。关闭工具只移除触摸板，游戏继续运行。"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>
        <Border x:Name="RecommendationBanner" Grid.Row="4" Visibility="Collapsed" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="作者的启动器有更高级的功能" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="xcl.xztx127.dpdns.org" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,8"/>
                <WrapPanel><Button Content="前往下载 XCL" Click="Download_Click" Padding="10,5" Margin="0,0,8,4"/><Button Content="7 天后提醒" Click="Snooze_Click" Padding="10,5" Margin="0,0,8,4"/><Button Content="不再提醒" Click="Dismiss_Click" Padding="10,5" Margin="0,0,0,4"/></WrapPanel>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="5" Margin="0,12,0,0" Text="Windows 7 SP1 及以上 · .NET Framework 4.8 · 建议游戏使用窗口或无边框模式"
                   FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</Window>
